# # Cấu hình ứng dụng
# APP_HOST=0.0.0.0
# APP_PORT=8000
# APP_ENV=development
# APP_TIMEZONE=Asia/Ho_Chi_Minh

# # Giá trị điều chỉnh nghiệp vụ
# MAX_QUANTITY=1000000000
# MATERIAL_LOW_THRESHOLD=50
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

# # Đường dẫn file/thư mục (để trống để dùng mặc định, hoặc ghi đường dẫn tuyệt đối)
# DATABASE_YAML_PATH=config/database.yaml
# PRODUCTION_QUERIES_YAML_PATH=config/production_queries.yaml
# RULES_YAML_PATH=config/rules.yaml
# MIGRATIONS_DIR=migrations
# STATIC_DIR=app/static

# # Cấu hình PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=denso_hackathon
